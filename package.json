{
  "name": "nhl92-build",
  "version": "1.0.0",
  "description": "Build scripts for NHL92",
  "scripts": {
    "assets": "node tools/prebuild.js dev",
    "extractassets": "node tools/extractAssets92.js nhl92retail.bin",
    "build:retail": "node tools/build.js retail",
    "build:reva": "node tools/build.js reva",
    "build:dev": "node tools/build.js dev",
    "build:logo": "node tools/build.js --logo",
    "build:sound": "node tools/build.js --sound",
    "verify:retail": "node tools/verifyRom.js output/nhl92.bin nhl92retail.bin",
    "verify:reva": "node tools/verifyRom.js output/nhl92-revA.bin nhl92retailRevA.bin",
    "checksum": "node tools/generateChecksum.js",
    "clean": "node tools/build.js --clean"
  },
  "license": "ISC"
}
